[0.111935, "o", "\u001b[1;34mnginx.conf\u001b[0m\r\n├── \u001b[36muser\u001b[0m nginx\r\n├── \u001b[36mworker_processes\u001b[0m auto\r\n├── \u001b[36merror_log\u001b[0m /var/log/nginx/error.log warn\r\n├── \u001b[36mpid\u001b[0m /var/run/nginx.pid\r\n├── \u001b[1mevents\u001b[0m\r\n│   ├── \u001b[36mworker_connections\u001b[0m 1024\r\n│   ├── \u001b[36mmulti_accept\u001b[0m on\r\n│   └── \u001b[36muse\u001b[0m epoll\r\n└── \u001b[1mhttp\u001b[0m\r\n    ├── \u001b[36mdefault_type\u001b[0m application/octet-stream\r\n    ├── \u001b[36m'\"$http_user_agent\"\u001b[0m \"$http_x_forwarded_for\"'\r\n    ├── \u001b[36maccess_log\u001b[0m /var/log/nginx/access.log  main\r\n    ├── \u001b[36msendfile\u001b[0m on\r\n    ├── \u001b[36mtcp_nopush\u001b[0m on\r\n    ├── \u001b[36mtcp_nodelay\u001b[0m on\r\n    ├── \u001b[36mkeepalive_timeout\u001b[0m 65\r\n    ├── \u001b[36mtypes_hash_max_size\u001b[0m 2048\r\n    ├── \u001b[1;35mupstream\u001b[0m backend\r\n    │   ├── \u001b[32mserver\u001b[0m backend1.example.com:8080 max_fails=3 fail_timeout=30s\r\n    │   └── \u001b[32mserver\u001b[0m backend2.example.com:8080 max_fails=3 fail_timeout=30s\r\n    └── \u001b"]
[0.112309, "o", "[1mserver\u001b[0m\r\n        ├── \u001b[36mlisten\u001b[0m 80 default_server\r\n        ├── \u001b[36mserver_name\u001b[0m example.com\r\n        ├── \u001b[1mlocation\u001b[0m /\r\n        │   ├── \u001b[36mproxy_pass\u001b[0m http://backend\r\n        │   ├── \u001b[36mproxy_set_header\u001b[0m Host $host\r\n        │   ├── \u001b[36mproxy_set_header\u001b[0m X-Real-IP $remote_addr\r\n        │   ├── \u001b[36mproxy_set_header\u001b[0m X-Forwarded-For $proxy_add_x_forwarded_for\r\n        │   ├── \u001b[36mproxy_http_version\u001b[0m 1.1\r\n        │   └── \u001b[36mproxy_set_header\u001b[0m Connection \"\"\r\n        └── \u001b[1mlocation\u001b[0m /health\r\n            ├── \u001b[36maccess_log\u001b[0m off\r\n            └── \u001b[36mreturn\u001b[0m 200 \"OK\"\r\n"]
